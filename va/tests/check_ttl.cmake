# the committed TTL and src/ports_*.h == what tools/gen_ttl.cpp writes now,
# for both plugins (-DGEN -DSRC -DOUT)
set (failed 0)
foreach (synth trio analog)
	set (name m${synth})
	file (MAKE_DIRECTORY ${OUT}/${name})
	execute_process (COMMAND ${GEN} ${synth} ${OUT}/${name} ${OUT}/${name}/ports_${name}.h RESULT_VARIABLE rc)
	if (NOT rc EQUAL 0)
		message (FATAL_ERROR "gen_ttl ${synth} failed")
	endif ()
	foreach (pair "${name}.lv2/manifest.ttl;manifest.ttl" "${name}.lv2/${name}.ttl;${name}.ttl"
			"${name}.lv2/presets.ttl;presets.ttl" "src/ports_${name}.h;ports_${name}.h")
		list (GET pair 0 committed)
		list (GET pair 1 generated)
		execute_process (COMMAND ${CMAKE_COMMAND} -E compare_files ${SRC}/${committed} ${OUT}/${name}/${generated}
			RESULT_VARIABLE rc)
		if (NOT rc EQUAL 0)
			message ("${committed} differs from the generator's output (${OUT}/${name}/${generated}): run the 'regenerate' target")
			set (failed 1)
		endif ()
	endforeach ()
endforeach ()
if (failed)
	message (FATAL_ERROR "the generated files are out of date")
endif ()
