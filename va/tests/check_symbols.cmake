# port symbols are API: every symbol in the frozen list is still generated
# (new ones may be added; add them to the list once released)
# (-DGEN -DSYNTH -DFROZEN -DOUT)
execute_process (COMMAND ${GEN} ${SYNTH} --symbols OUTPUT_FILE ${OUT} RESULT_VARIABLE rc)
if (NOT rc EQUAL 0)
	message (FATAL_ERROR "gen_ttl ${SYNTH} --symbols failed")
endif ()
file (STRINGS ${FROZEN} frozen REGEX "^[a-z0-9_]+$")
file (STRINGS ${OUT} current)
set (missing)
foreach (sym ${frozen})
	list (FIND current ${sym} i)
	if (i LESS 0)
		list (APPEND missing ${sym})
	endif ()
endforeach ()
list (LENGTH frozen n)
if (missing)
	message (FATAL_ERROR "frozen port symbols missing: ${missing}")
endif ()
if (n EQUAL 0)
	message (FATAL_ERROR "no frozen symbols in ${FROZEN}")
endif ()
message ("${n} frozen symbols present")
