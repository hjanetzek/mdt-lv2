<https://github.com/hjanetzek/mdt-lv2/edrumsynth#project>
	a rdf:Property ;
	rdfs:label "Project" ;
	rdfs:comment "the sequencer's project: patterns, kits, songs and globals of an LXR project (engine/Synth_LXR/src/lxr_sequencer.c: the layout), saved and restored with the plugin's state" ;
	rdfs:range atom:Chunk .

<https://github.com/hjanetzek/mdt-lv2/edrumsynth>
	a lv2:Plugin , lv2:InstrumentPlugin , doap:Project ;
	doap:name "eDrumSynth" ;
	lv2:project <https://github.com/hjanetzek/mdt-lv2/edrumsynth> ;
	doap:license <https://spdx.org/licenses/GPL-3.0-only> ;
	doap:maintainer [
		foaf:name "Hannes Janetzek" ;
		foaf:mbox <mailto:hannes.janetzek@gmail.com> ;
		foaf:homepage <https://github.com/hjanetzek/mdt-lv2>
	] ;
	doap:homepage <https://github.com/hjanetzek/mdt-lv2> ;
	doap:shortdesc "Synthesized drums" ;
	lv2:minorVersion 3 ;
	lv2:microVersion 0 ;
	rdfs:comment "Synthesized drums: six voices (bass drum, two toms, snare, cymbal, hi-hat closed and open) from MicroDexed-touch's drum engine, the voices of the OpenElixir-02 firmware (based on the open source LXR V2 firmware by Erica Synths). Each voice runs a drum, snare, cymbal or hi-hat engine. General MIDI drum notes, or channels 1-7 playing the voices chromatically; every voice parameter as a control. The LXR's step sequencer (patterns with parameter locks, flams, probabilities, kits per pattern, songs) following the host's transport, edited through the Seq controls; the project is the plugin's state." ;
	lv2:requiredFeature urid:map ;
	lv2:optionalFeature lv2:hardRTCapable , lv2:isLive ;
	lv2:extensionData state:interface ;
	pg:mainOutput <https://github.com/hjanetzek/mdt-lv2/edrumsynth#out> ;
	lv2:port [
		a lv2:InputPort , atom:AtomPort ;
		atom:bufferType atom:Sequence ;
		atom:supports midi:MidiEvent , time:Position ;
		lv2:designation lv2:control ;
		lv2:index 0 ;
		lv2:symbol "midi_in" ;
		lv2:name "MIDI In"
	] , [
		a lv2:OutputPort , lv2:AudioPort ;
		lv2:index 1 ;
		lv2:symbol "out_l" ;
		lv2:name "Left" ;
		pg:group <https://github.com/hjanetzek/mdt-lv2/edrumsynth#out> ;
		lv2:designation pg:left
	] , [
		a lv2:OutputPort , lv2:AudioPort ;
		lv2:index 2 ;
		lv2:symbol "out_r" ;
		lv2:name "Right" ;
		pg:group <https://github.com/hjanetzek/mdt-lv2/edrumsynth#out> ;
		lv2:designation pg:right
	] , [
		a lv2:InputPort , lv2:ControlPort ;
		lv2:index 3 ;
		lv2:symbol "bd_mix_engine" ;
		lv2:name "Engine" ;
		rdfs:comment "the voice engine of this slot: switching resets the slot in the engine, then the slot's controls (the shared ones and the new engine's groups) are sent again" ;
		lv2:default 0 ;
		lv2:minimum 0 ;
		lv2:maximum 3 ;
		lv2:portProperty lv2:integer , lv2:enumeration ;
		lv2:scalePoint [ rdfs:label "Drum" ; rdf:value 0 ] , [ rdfs:label "Snare" ; rdf:value 1 ] , [ rdfs:label "Cymbal" ; rdf:value 2 ] , [ rdfs:label "Hi-Hat" ; rdf:value 3 ] ;
		pg:group <https://github.com/hjanetzek/mdt-lv2/edrumsynth#bd_mix> ;
		lv2:displayPriority 100
	] , [
		a lv2:InputPort , lv2:ControlPort ;
		lv2:index 4 ;
		lv2:symbol "bd_mix_volume" ;
		lv2:name "Volume" ;
		lv2:default 127 ;
		lv2:minimum 0 ;
		lv2:maximum 127 ;
		lv2:portProperty lv2:integer ;
