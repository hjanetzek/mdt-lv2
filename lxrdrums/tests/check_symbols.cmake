# port symbols are API: every symbol in tests/symbols.txt (frozen) is still
# generated (new ones may be added; add them to symbols.txt once released)
# (-DGEN -DFROZEN -DOUT)
execute_process (COMMAND ${GEN} --symbols OUTPUT_FILE ${OUT} RESULT_VARIABLE rc)
if (NOT rc EQUAL 0)
	message (FATAL_ERROR "gen_ttl --symbols failed")
endif ()
file (STRINGS ${FROZEN} frozen REGEX "^[a-z0-9_]+$")
file (STRINGS ${OUT} current)
set (missing)
foreach (sym ${frozen})
	list (FIND current ${sym} i)
	if (i LESS 0)
		list (APPEND missing ${sym})
	endif ()
endforeach ()
list (LENGTH frozen n)
if (missing)
	message (FATAL_ERROR "frozen port symbols missing: ${missing}")
endif ()
message ("${n} frozen symbols present")
